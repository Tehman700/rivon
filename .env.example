# Copy to .env for local development. Never commit .env.

RIVON_ENV=local
# Region this deployment serves (eu | non_eu). Tenants of other regions are refused.
RIVON_DEPLOYMENT_REGION=eu

# Used by docker compose to create the database roles on first start.
POSTGRES_PASSWORD=postgres_dev_password
RIVON_DB_OWNER_PASSWORD=rivon_owner_dev_password
RIVON_DB_APP_PASSWORD=rivon_app_dev_password
RIVON_DB_RELAY_PASSWORD=rivon_relay_dev_password

# Used when running the app, Alembic or tests on the host (compose ports).
# App role: subject to row level security.
RIVON_DATABASE_URL=postgresql+asyncpg://rivon_app:rivon_app_dev_password@localhost:5433/rivon
# Owner role: Alembic only.
RIVON_MIGRATION_DATABASE_URL=postgresql+asyncpg://rivon_owner:rivon_owner_dev_password@localhost:5433/rivon
# Relay role: outbox relay only.
RIVON_RELAY_DATABASE_URL=postgresql+asyncpg://rivon_relay:rivon_relay_dev_password@localhost:5433/rivon
RIVON_REDIS_URL=redis://localhost:6380/0

# Signs access tokens. Dev value only: generate a real one per environment with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
RIVON_JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef

# LLM access, used from Phase 2 onwards (conversations). Keep the real key out of git.
RIVON_OPENAI_API_KEY=sk-proj-...
